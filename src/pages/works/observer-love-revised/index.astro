---
import Layout from "../../../layouts/Layout.astro";
import HeroSection from "../../../components/observer-love-revised/HeroSection.astro";
import StorySection from "../../../components/observer-love-revised/StorySection.astro";
import CharactersSection from "../../../components/observer-love-revised/CharactersSection.astro";
import PointSection from "../../../components/observer-love-revised/PointSection.astro";
import CtaSection from "../../../components/observer-love-revised/CtaSection.astro";

const title = "観測者は恋を知る 改訂版";
const description =
  "理性で心を閉ざした大学講師・藤堂圭と、執着にも似た想いを向ける教え子・秋吉悠也。年下執着攻め×眼鏡受け、傷を抱えた大人の再生を描くBL小説『観測者は恋を知る』改訂版・特設サイト。";
---

<Layout title={title} description={description} ogImage="/images/observer-love-revised/ogp.png">
  <div class="lp-container">
    <HeroSection />
    <StorySection />
    <CharactersSection />
    <PointSection />
    <CtaSection />

    <footer class="lp-footnote">
      <p>※本作は2025年に発表した旧版を全面改稿した改訂版です。</p>
    </footer>
  </div>
</Layout>

<style>
  :root {
    --lp-bg: #fffafa;
    --lp-text: #5d4a4a;
    --lp-text-dim: #9b8a8a;
    --lp-accent: #c48995;
    --lp-glass: rgba(255, 255, 255, 0.5);
    --lp-glass-border: rgba(216, 167, 177, 0.3);
  }

  .lp-container {
    background-color: var(--lp-bg);
    color: var(--lp-text);
    margin: -2rem -1rem;
    padding: 0 1rem;
    overflow-x: hidden;
  }

  :global(.section-container) {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  :global(.glass-card) {
    background: var(--lp-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--lp-glass-border);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    box-shadow: 0 8px 32px rgba(216, 167, 177, 0.1);
  }

  :global(.section-title-en) {
    font-size: 1.1rem;
    letter-spacing: 0.4em;
    text-align: center;
    margin-bottom: 1.8rem;
    color: var(--lp-accent);
    font-weight: 300;
    opacity: 0.7;
  }

  .lp-footnote {
    padding: 3rem 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--lp-text-dim);
    border-top: 1px solid var(--lp-glass-border);
  }

  @media (max-width: 768px) {
    .lp-container {
      margin: -2rem -1rem;
    }
    :global(.glass-card) {
      padding: 2rem 1.5rem;
    }
  }
</style>
