---
// src/pages/works/[workId].astro
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SSDetail from "../../components/works/SSDetail.astro";
import ShortStoryDetail from "../../components/works/ShortStoryDetail.astro";
import SeriesDetail from "../../components/works/SeriesDetail.astro";

export async function getStaticPaths() {
  const allWorks = await getCollection("works");
  const allEpisodes = await getCollection("episodes");

  // IDから拡張子を除くヘルパー関数
  const cleanId = (id: string) =>
    id
      .split("/")
      .pop()
      ?.replace(/\.[^/.]+$/, "") || id;

  return allWorks.map((work) => {
    const workSlug = cleanId(work.id);

    // 作品内のエピソードを抽出
    const workEpisodes = allEpisodes
      .filter((episode) => {
        return episode.data.workId === workSlug;
      })
      .sort((a, b) => a.data.order - b.data.order);

    return {
      params: { workId: workSlug },
      props: {
        work,
        episodes: workEpisodes,
        firstEpisode: workEpisodes.length > 0 ? workEpisodes[0] : null,
      },
    };
  });
}

const { work, episodes, firstEpisode } = Astro.props;
const isShortStory = work.data.isShort;
const isSS = work.data.category === "ss";

console.log("--- Page Debug ---");
console.log("Work ID:", work.id);
console.log("Images Data:", JSON.stringify(work.data.images, null, 2));

let Content = null;
if (isShortStory && firstEpisode) {
  const rendered = await render(firstEpisode);
  Content = rendered.Content;
} else if (isSS && firstEpisode) {
  // SSでも本文（キャプション等）がある場合はレンダリングする
  const rendered = await render(firstEpisode);
  Content = rendered.Content;
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const cleanId = (id: string) =>
  id
    .split("/")
    .pop()
    ?.replace(/\.[^/.]+$/, "") || id;
// 最新エピソードのIDを取得
let latestEpisodeId: string | null = null;
if (episodes.length > 0) {
  latestEpisodeId = cleanId(episodes[episodes.length - 1].id);
}

const shouldShowWorkUpdateBadge = work.data.isUpdated;

// SEO設定
const pageTitle = isShortStory
  ? work.data.title
  : `${work.data.title} 作品詳細・目次`;

const pageDescription = work.data.description
  ? work.data.description.substring(0, 120)
  : `${work.data.title}の作品情報とエピソード一覧のページです。`;

const categoryNames = {
  series: "観測者シリーズ",
  single: "単発作品",
  ss: "掌編小説",
};

const workBasePath = `${baseUrl}/works/${cleanId(work.id)}`;
const parseMarkdownLinks = (text: string) => {
  // Markdownの [リンク名](URL) 形式を抽出して <a> タグに変換
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
  );
};
---

<Layout title={pageTitle} description={pageDescription} narrow={false}>
  {
    isSS ? (
      <SSDetail 
        work={work} 
        Content={Content} 
        parseMarkdownLinks={parseMarkdownLinks} 
      />
    ) : isShortStory && Content ? (
      <ShortStoryDetail 
        work={work} 
        Content={Content} 
        firstEpisode={firstEpisode} 
        categoryNames={categoryNames} 
        parseMarkdownLinks={parseMarkdownLinks} 
        baseUrl={baseUrl} 
      />
    ) : (
      <SeriesDetail 
        work={work} 
        episodes={episodes} 
        categoryNames={categoryNames} 
        parseMarkdownLinks={parseMarkdownLinks} 
        workBasePath={workBasePath} 
        shouldShowWorkUpdateBadge={shouldShowWorkUpdateBadge} 
        latestEpisodeId={latestEpisodeId} 
        cleanId={cleanId} 
      />
    )
  }
</Layout>

<style>
  /* 短編表示時のフッター調整用 */
  /* NovelViewerを使っている場合、Layout側でpaddingが必要 */
  :global(.site-footer) {
    padding-bottom: 6rem !important;
  }
</style>
