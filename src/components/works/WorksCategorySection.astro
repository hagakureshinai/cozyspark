---
// src/components/works/WorksCategorySection.astro
interface Props {
  title: string;
  description?: string;
  isPickup?: boolean;
}

const { title, description, isPickup = false } = Astro.props;
---

<section class={`work-category ${isPickup ? "pickup-section" : ""}`}>
  {isPickup ? (
    <h2>{title}</h2>
  ) : (
    <div class="category-header-group">
      <h2>{title}</h2>
      {description && <p class="category-info">{description}</p>}
    </div>
  )}

  <ul class="work-list">
    <slot />
  </ul>
</section>

<style>
  .pickup-section {
    padding: 1.5rem;
    border: 1px solid #e7d1d5;
    border-radius: 8px;
  }

  .work-category {
    margin-bottom: 3rem;
  }

  .category-header-group {
    background-color: #f4f4f4;
    border-left: 4px solid var(--accent-color);
    padding: 0.8rem 1rem;
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: bold;
    color: #555;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: none;
    border: none;
    padding: 0;
  }

  .category-info {
    font-size: 0.85rem;
    color: #777;
    margin: 0.3rem 0 0 0;
  }

  .work-list {
    list-style: none;
    padding: 0;
  }
</style>
