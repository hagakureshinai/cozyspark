---
import EpisodeList from "./EpisodeList.astro";

interface Props {
  work: any;
  episodes: any[];
  categoryNames: Record<string, string>;
  parseMarkdownLinks: (text: string) => string;
  workBasePath: string;
  shouldShowWorkUpdateBadge: boolean;
  latestEpisodeId: string | null;
  cleanId: (id: string) => string;
}

const {
  work,
  episodes,
  categoryNames,
  parseMarkdownLinks,
  workBasePath,
  shouldShowWorkUpdateBadge,
  latestEpisodeId,
  cleanId
} = Astro.props;
---
<div class="work-detail-content">
  <header class="work-header">
    <h1 class="work-title-large">{work.data.title}</h1>
    {work.data.description && (
      <p class="work-description" set:html={parseMarkdownLinks(work.data.description)} />
    )}
    <div class="work-meta">
      <span class="category">{categoryNames[work.data.category]}</span>
      {work.data.status === "ongoing" ? (
        <span class="badge-ongoing">連載中</span>
      ) : (
        <span class="badge-completed">完結済</span>
      )}
      {work.data.lastUpdated && (
        <time class="work-date">
          最終更新：
          {work.data.lastUpdated
            .toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })
            .replace(/\//g, ".")}
        </time>
      )}
    </div>
  </header>

  <EpisodeList
    episodes={episodes}
    workBasePath={workBasePath}
    shouldShowWorkUpdateBadge={shouldShowWorkUpdateBadge}
    latestEpisodeId={latestEpisodeId}
    cleanId={cleanId}
  />
</div>

<style>
  .work-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 2rem;
  }
  .work-title-large {
    font-size: 2rem;
    font-weight: normal;
    margin-bottom: 1rem;
  }
  .work-description {
    margin-bottom: 1.5rem;
    line-height: 1.6;
    color: #444;
  }
  .work-meta {
    font-size: 0.9rem;
    color: #888;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .badge-ongoing,
  .badge-completed {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
  }
  .badge-ongoing {
    background: #4f8fa8;
    color: #fff;
    white-space: nowrap;
  }
  .badge-completed {
    background: #7faf8f;
    color: #fff;
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .work-date {
      flex-basis: 100%;
      margin-top: 0.2rem;
    }
  }
</style>
