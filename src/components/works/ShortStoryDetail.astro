---
import NovelViewer from "../NovelViewer.astro";

interface Props {
  work: any;
  Content: any;
  firstEpisode: any;
  categoryNames: Record<string, string>;
  parseMarkdownLinks: (text: string) => string;
  baseUrl: string;
}

const { work, Content, firstEpisode, categoryNames, parseMarkdownLinks, baseUrl } = Astro.props;
---
<div class="work-detail-content">
  <header class="work-header">
    <h1 class="work-title-large">{work.data.title}</h1>
    {work.data.description && (
      <p class="work-description" set:html={parseMarkdownLinks(work.data.description)} />
    )}
    <div class="work-meta">
      <span class="category">{categoryNames[work.data.category]}</span>
      <span class="badge-completed">完結済</span>
      {work.data.lastUpdated && (
        <time class="work-date">
          最終更新：
          {work.data.lastUpdated
            .toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })
            .replace(/\//g, ".")}
        </time>
      )}
    </div>
  </header>

  <div class="short-story-wrapper">
    <NovelViewer
      title={firstEpisode!.data.title}
      workTitle=""
      workLink="#"
      indexLink={`${baseUrl}/works/`}
      isShortStory={true}
    >
      <Content />
    </NovelViewer>
  </div>
</div>

<style>
  .work-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 2rem;
  }
  .work-title-large {
    font-size: 2rem;
    font-weight: normal;
    margin-bottom: 1rem;
  }
  .work-description {
    margin-bottom: 1.5rem;
    line-height: 1.6;
    color: #444;
  }
  .work-meta {
    font-size: 0.9rem;
    color: #888;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .badge-completed {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    background: #7faf8f;
    color: #fff;
    white-space: nowrap;
  }
  .short-story-wrapper {
    max-width: 700px;
    margin: 0 auto;
    padding-top: 2rem;
  }
  @media (max-width: 768px) {
    .work-date {
      flex-basis: 100%;
      margin-top: 0.2rem;
    }
  }
</style>
