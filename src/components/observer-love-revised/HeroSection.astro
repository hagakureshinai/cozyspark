<section class="hero">
  <div class="diagram-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">
      <span>観測者は</span><br />
      <span>恋を知る</span>
    </h1>
    <div class="hero-copy-group">
      <p class="hero-catch">
        感情はノイズだと、<span class="br-mobile"></span>ずっとそう思っていた。<br />
        その眼差しに囚われるまでは。
      </p>
    </div>
  </div>
  <div class="scroll-indicator">
    <span>Scroll</span>
    <div class="line"></div>
  </div>
</section>

<style>
  /* --- Hero Section --- */
  .hero {
    height: 90vh;
    min-height: 650px; /* 画面が低くても重ならないよう最小高さを確保 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    background: radial-gradient(circle at center, #ffffff 0%, #fff0f3 100%);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(rgba(216, 167, 177, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 167, 177, 0.1) 1px, transparent 1px);
    background-size: 100px 100px;
    mask-image: radial-gradient(circle at center, black, transparent 80%);
    z-index: 0;
  }

  .hero::after {
    content: "";
    position: absolute;
    width: 800px;
    height: 800px;
    border: 1px solid rgba(216, 167, 177, 0.1);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
  }

  .diagram-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    opacity: 0.4;
    pointer-events: none;
  }

  .diagram-overlay::before {
    content: "";
    position: absolute;
    width: 400px;
    height: 400px;
    border: 0.5px solid rgba(216, 167, 177, 0.2);
    top: 20%;
    left: 10%;
    transform: rotate(45deg);
  }

  .diagram-overlay::after {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    border: 0.5px solid rgba(216, 167, 177, 0.2);
    border-radius: 50%;
    bottom: 10%;
    right: 5%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    margin-bottom: 4rem; /* Scrollインジケーターとの被りを防ぐための余白 */
  }

  .hero-label {
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--lp-accent);
    margin-bottom: 1rem;
    text-transform: uppercase;
    animation: fadeInDown 1.5s ease-out;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 1.3;
    margin-bottom: 1.5rem;
  }

  .hero-title span {
    display: inline-block;
    animation: fadeInUp 1.5s ease-out;
  }

  .hero-copy-group {
    animation: fadeIn 2s ease-out 1s both;
  }

  .hero-catch {
    font-size: 1.4rem;
    line-height: 1.8;
    letter-spacing: 0.2em;
    margin-bottom: 0;
    color: var(--lp-text);
  }

  .hero-subcopy {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--lp-text-dim);
    letter-spacing: 0.1em;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    color: var(--lp-text-dim);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .scroll-indicator .line {
    width: 1px;
    height: 45px;
    background: linear-gradient(to bottom, var(--lp-accent), transparent);
    animation: scrollLine 2s infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes scrollLine {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  .br-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    .hero-catch {
      font-size: 1.2rem;
    }
    .br-mobile {
      display: block;
    }
  }
</style>
