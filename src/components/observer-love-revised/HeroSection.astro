---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const bgUrl = `${baseUrl}/images/observer-love-revised/hero-bg.png`;
---
<section class="hero" style={`background-image: url('${bgUrl}')`}>
  <div class="hero-content">
    <h1 class="hero-title">
      <span>観測者は</span><br />
      <span>恋を知る</span>
    </h1>
    <div class="hero-copy-group">
      <p class="hero-catch">
        感情はノイズだと、<span class="br-mobile"></span>ずっとそう思っていた。<br />
        その眼差しに囚われるまでは。
      </p>
    </div>
  </div>
  <div class="scroll-indicator">
    <span>Scroll</span>
    <div class="line"></div>
  </div>
</section>

<style>
  /* --- Hero Section --- */
  .hero {
    height: 90vh;
    min-height: 650px; /* 画面が低くても重ならないよう最小高さを確保 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #fffafa;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    margin-bottom: 4rem; /* Scrollインジケーターとの被りを防ぐための余白 */
  }

  .hero-label {
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--lp-accent);
    margin-bottom: 1rem;
    text-transform: uppercase;
    animation: fadeInDown 1.5s ease-out;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 1.3;
    margin-bottom: 1.5rem;
  }

  .hero-title span {
    display: inline-block;
    animation: fadeInUp 1.5s ease-out;
  }

  .hero-copy-group {
    animation: fadeIn 2s ease-out 1s both;
  }

  .hero-catch {
    font-size: 1.4rem;
    line-height: 1.8;
    letter-spacing: 0.2em;
    margin-bottom: 0;
    color: var(--lp-text);
  }

  .hero-subcopy {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--lp-text-dim);
    letter-spacing: 0.1em;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    color: var(--lp-text-dim);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .scroll-indicator .line {
    width: 1px;
    height: 45px;
    background: linear-gradient(to bottom, var(--lp-accent), transparent);
    animation: scrollLine 2s infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes scrollLine {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  .br-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    .hero-catch {
      font-size: 1.2rem;
    }
    .br-mobile {
      display: block;
    }
  }
</style>
