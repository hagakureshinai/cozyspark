---
const characters = [
  {
    role: "University Student",
    name: "秋吉 悠也",
    nameEn: "Akiyoshi Yuya",
    quote: "<span class='text-block'>「藤堂先生に</span><span class='text-block'>指導してもらいたいです」</span>",
    description: [
      "<span class='text-block'>才能も容姿も恵まれながら、</span><wbr><span class='text-block'>満たされない渇きを抱える青年。</span>",
      "<span class='text-block'>はじめて『本気で向き合ってくれた』圭に</span><wbr><span class='text-block'>執着にも似た一途な想いを向け、</span><wbr><span class='text-block'>迷いなく踏み込んでいく。</span>"
    ]
  },
  {
    role: "Lecturer",
    name: "藤堂 圭",
    nameEn: "Todo Kei",
    quote: "<span class='text-block'>「感情に価値はない。</span><span class='text-block'>判断を鈍らせるだけだ」</span>",
    description: [
      "<span class='text-block'>理性を信奉し、</span><wbr><span class='text-block'>誰にも心を開かない孤高の大学講師。</span>",
      "<span class='text-block'>だがその冷たさの奥には、</span><wbr><span class='text-block'>裏切りによって刻まれた深い傷を隠している。</span>"
    ]
  }
];
---

<section class="characters">
  <div class="section-container">
    <h2 class="section-title-en">CHARACTERS</h2>
    
    <div class="char-grid">
      {characters.map((char, index) => (
        <article class="glass-card char-card">
          <div class={`card-bg-diagram variant-${index % 2}`}></div>
          <header class="char-content-layer">
            <span class="char-role">{char.role}</span>
            <h3 class="char-name">{char.name} <span>{char.nameEn}</span></h3>
          </header>
          
          <blockquote class="char-quote char-content-layer" set:html={char.quote}></blockquote>
          
          <div class="char-desc char-content-layer">
            {char.description.map((text) => (
              <p set:html={text} />
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .characters {
    padding: 4rem 0;
  }

  /* --- カード背景の図形デザイン --- */
  .char-card {
    position: relative;
    overflow: hidden;
  }

  .card-bg-diagram {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.85; /* さらに濃くはっきりと */
    /* 共通の細かいグリッド */
    background-image:
      linear-gradient(rgba(196, 137, 149, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(196, 137, 149, 0.25) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at center, black, transparent 95%);
  }

  /* --- バリエーション 0 (1枚目, 3枚目...) : 悠也 --- */
  .variant-0::before {
    /* 右上に大きな円 */
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border: 1px solid rgba(196, 137, 149, 0.4);
    border-radius: 50%;
    top: -10%;
    right: -10%;
  }

  .variant-0::after {
    /* 左下に小さな斜めの四角 */
    content: "";
    position: absolute;
    width: 120px;
    height: 120px;
    border: 1.5px solid rgba(196, 137, 149, 0.5);
    bottom: -5%;
    left: -5%;
    transform: rotate(15deg);
  }

  /* --- バリエーション 1 (2枚目, 4枚目...) : 圭 --- */
  .variant-1::before {
    /* 左上に斜めの四角 */
    content: "";
    position: absolute;
    width: 200px;
    height: 200px;
    border: 1px solid rgba(196, 137, 149, 0.4);
    top: -10%;
    left: -10%;
    transform: rotate(30deg);
  }

  .variant-1::after {
    /* 右下に小さな円 */
    content: "";
    position: absolute;
    width: 150px;
    height: 150px;
    border: 1.5px solid rgba(196, 137, 149, 0.5);
    border-radius: 50%;
    bottom: -5%;
    right: -5%;
  }

  /* 図形の上に文字を表示するためのレイヤー設定 */
  .char-content-layer {
    position: relative;
    z-index: 1;
  }
  .char-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .char-role {
    font-size: 0.8rem;
    color: var(--lp-accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .char-name {
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
  }
  .char-name span {
    font-size: 0.9rem;
    color: var(--lp-text-dim);
    display: block;
    font-weight: 300;
    margin-top: 0.2rem;
  }
  .char-quote {
    font-size: 1rem;
    color: var(--lp-accent);
    margin: 0 0 1.5rem 0; /* blockquoteの初期マージンをリセット */
    font-style: italic;
    border-left: 2px solid var(--lp-accent);
    padding-left: 1rem;
    text-align: left;
  }
  .char-desc {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--lp-text-dim);
    text-align: left;
  }
  :global(.text-block) {
    display: inline-block;
  }
  @media (max-width: 768px) {
    .char-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
